digraph {
bgcolor="#283f3f";
rankdir=TB;
nodesep=0.8;
ranksep=0.9;
node50 [shape=circle; style=filled; fillcolor="#6A184DA0"; fontcolor="#FFFFFF";
       label="50"];
{ rank=source; node50 };
node10 [shape=circle; style=filled; fillcolor="#6A184DA0"; fontcolor="#FFFFFF";
       label="10"];
{ rank=sink; node10 };
edge [color="#FFFFFF"];
node50 -> node10
;node20 [shape=circle; style=filled; fillcolor="#6A184DA0"; fontcolor="#FFFFFF";
       label="20"];
{ rank=sink; node20 };
edge [color="#FFFFFF"];
node50 -> node20
;}
